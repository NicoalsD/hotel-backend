{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Entorno de Elastic Beanstalk para el backend del sistema de reservas de hotel (hotel-backend)",
  "Parameters": {
    "ArtifactKey": {
      "Type": "String",
      "Default": "hotel-backend.jar",
      "Description": "Clave (ruta) del artefacto del backend dentro del bucket de artefactos"
    },
    "CorsAllowedOrigins": {
      "Type": "String",
      "Default": "http://localhost:5173,https://*.vercel.app",
      "Description": "Orígenes permitidos por CORS, separados por coma"
    }
  },
  "Resources": {
    "WebTierRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "hotel-backend-ec2-web-tier",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AWSElasticBeanstalkWebTier"
        ]
      }
    },
    "WebTierInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "InstanceProfileName": "hotel-backend-ec2-web-tier",
        "Roles": [
          {
            "Ref": "WebTierRole"
          }
        ]
      }
    },
    "HotelApplication": {
      "Type": "AWS::ElasticBeanstalk::Application",
      "Properties": {
        "ApplicationName": "hotel-backend",
        "Description": "Backend REST del sistema de reservas de hotel"
      }
    },
    "HotelApplicationVersion": {
      "Type": "AWS::ElasticBeanstalk::ApplicationVersion",
      "Properties": {
        "ApplicationName": {
          "Ref": "HotelApplication"
        },
        "Description": "Versión del backend desplegada desde S3",
        "SourceBundle": {
          "S3Bucket": "hotel-backend-artifacts-532475280984",
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        }
      }
    },
    "HotelEnvironment": {
      "Type": "AWS::ElasticBeanstalk::Environment",
      "Properties": {
        "EnvironmentName": "hotel-backend-prod",
        "CNAMEPrefix": "hotel-backend-grupo",
        "ApplicationName": {
          "Ref": "HotelApplication"
        },
        "VersionLabel": {
          "Ref": "HotelApplicationVersion"
        },
        "SolutionStackName": "64bit Amazon Linux 2023 v4.13.0 running Corretto 17",
        "OptionSettings": [
          {
            "Namespace": "aws:elasticbeanstalk:environment",
            "OptionName": "EnvironmentType",
            "Value": "SingleInstance"
          },
          {
            "Namespace": "aws:autoscaling:launchconfiguration",
            "OptionName": "InstanceType",
            "Value": "t3.small"
          },
          {
            "Namespace": "aws:autoscaling:launchconfiguration",
            "OptionName": "IamInstanceProfile",
            "Value": {
              "Ref": "WebTierInstanceProfile"
            }
          },
          {
            "Namespace": "aws:elasticbeanstalk:application:environment",
            "OptionName": "PORT",
            "Value": "5000"
          },
          {
            "Namespace": "aws:elasticbeanstalk:application:environment",
            "OptionName": "CORS_ALLOWED_ORIGINS",
            "Value": {
              "Ref": "CorsAllowedOrigins"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "EnvironmentUrl": {
      "Description": "URL pública del backend",
      "Value": {
        "Fn::Join": [
          "",
          [
            "http://",
            {
              "Fn::GetAtt": [
                "HotelEnvironment",
                "EndpointURL"
              ]
            }
          ]
        ]
      }
    }
  }
}
